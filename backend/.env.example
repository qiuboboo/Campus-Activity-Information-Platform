FLASK_ENV=development
AUTO_CREATE_TABLES=true
# Docker Compose overrides this to false and runs `flask db upgrade` first.
# Docker Compose overrides this to false and executes `flask db upgrade`.
DATABASE_URL=sqlite:///app.db
JWT_SECRET_KEY=change-this-in-production
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456
POSTERS_PER_PAGE=10
REDIS_URL=redis://localhost:6379/0
EMBEDDING_ENABLED=false

# --- Uploads and recommendations ---
# UPLOAD_DIR=uploads
# MAX_UPLOAD_SIZE=10485760
# RECOMMENDATION_ENABLED=true

# --- Embedding Service (optional, used when EMBEDDING_ENABLED=true) ---
# Defaults to Copilot Pro proxy endpoint:
# EMBEDDING_API_URL=http://copilot-proxy:4141/v1/embeddings
# EMBEDDING_API_KEY=copilot
# EMBEDDING_MODEL=text-embedding-3-small

# --- AI Service ---
LLM_API_KEY=sk-your-key-here
LLM_API_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- MCP Service ---
MCP_SERVERS=

# --- Copilot Pro Proxy (optional) ---
# GH_TOKEN=ghu_xxx
# LLM_COPILOT_KEY=copilot
# LLM_COPILOT_BASE_URL=http://copilot-proxy:4141/v1
# LLM_COPILOT_MODEL=gpt-4.1

# --- Crawler Security ---
CRAWL_REQUEST_INTERVAL=2
CRAWL_CONNECT_TIMEOUT=5
CRAWL_READ_TIMEOUT=30
CRAWL_REQUEST_RETRIES=2
CRAWL_RETRY_BACKOFF_SECONDS=1
CRAWL_MAX_PAGES=50
CRAWL_SOFT_TIMEOUT=1800
CRAWL_BLOCK_INTERNAL=true
